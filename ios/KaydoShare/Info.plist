<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.kaydo.share</string>
    <key>CFBundleName</key>
    <string>KAYDO SHARE</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>NSLocalNetworkUsageDescription</key>
    <string>KAYDO SHARE utilise le réseau local pour transférer vos fichiers hors ligne directement entre votre iPhone et d'autres appareils sans Internet.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_kaydo-share._tcp</string>
        <string>_kaydo-share._udp</string>
    </array>
    <key>NSCameraUsageDescription</key>
    <string>La caméra est requise pour scanner les QR codes de session et appairer les appareils en direct.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Accès nécessaire pour sélectionner et sauvegarder des photos et vidéos dans votre pellicule.</string>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
</dict>
</plist>
